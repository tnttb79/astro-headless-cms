---
import { getSiteSettings } from "../lib/wix/data";
import type { SiteSettings } from "../types/content";

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

// getSiteSettings guards its own SDK call and returns a fallback on failure (Caveat A3).
const settings: SiteSettings = await getSiteSettings();
const pageTitle = title ? `${title} — ${settings.businessName}` : settings.businessName;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <style is:global>
      :root {
        --brand: #2f5d50;
        --brand-dark: #244a40;
        --ink: #1f2724;
        --muted: #5c6b64;
        --bg: #f7f5f0;
        --card: #ffffff;
        --line: #e2ddd3;
        --radius: 12px;
        --max: 1080px;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: ui-sans-serif, system-ui, -apple-system, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        color: var(--ink);
        background: var(--bg);
        line-height: 1.6;
      }
      a { color: var(--brand); }
      .wrap { max-width: var(--max); margin: 0 auto; padding: 0 1.25rem; }
      .site-header {
        background: var(--card);
        border-bottom: 1px solid var(--line);
      }
      .site-header .wrap {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 1rem;
        padding-top: 1rem;
        padding-bottom: 1rem;
        flex-wrap: wrap;
      }
      .brand { font-weight: 700; font-size: 1.15rem; color: var(--brand-dark); text-decoration: none; }
      .brand small { display: block; font-weight: 400; font-size: 0.75rem; color: var(--muted); }
      nav a { margin-left: 1.1rem; text-decoration: none; color: var(--ink); font-size: 0.95rem; }
      nav a:hover { color: var(--brand); }
      .btn {
        display: inline-block;
        background: var(--brand);
        color: #fff;
        padding: 0.6rem 1.1rem;
        border-radius: 999px;
        text-decoration: none;
        font-weight: 600;
        font-size: 0.95rem;
      }
      .btn:hover { background: var(--brand-dark); }
      main { padding: 2.5rem 0 3rem; }
      .site-footer {
        background: var(--brand-dark);
        color: #dfeae4;
        padding: 2rem 0;
        font-size: 0.9rem;
      }
      .site-footer a { color: #fff; }
      .site-footer .cols { display: grid; gap: 1.5rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
      .disclaimer { margin-top: 1.5rem; font-size: 0.8rem; color: #b8c9c1; }
    </style>
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="brand" href="/">
          {settings.businessName}
          <small>{settings.doctorName}</small>
        </a>
        <nav>
          <a href="/">Home</a>
          <a href="/treatments">Treatments</a>
          <a href="/contact">Contact</a>
          <a class="btn" href={settings.bookingUrl}>Book Appointment</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="wrap">
        <slot />
      </div>
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="cols">
          <div>
            <strong>{settings.businessName}</strong><br />
            {settings.address}
          </div>
          <div>
            <a href={`tel:${settings.phone.replace(/[^\d+]/g, "")}`}>{settings.phone}</a><br />
            <a href={`mailto:${settings.email}`}>{settings.email}</a>
          </div>
          <div>
            {settings.weekdayHours}<br />
            {settings.saturdayHours}<br />
            {settings.sundayHours}
          </div>
        </div>
        <p class="disclaimer">{settings.medicalDisclaimer}</p>
      </div>
    </footer>
  </body>
</html>

---
import "../styles/global.css";
import { getLocations, getSiteSettings } from "../lib/wix/data";
import Header from "../components/layout/Header.astro";
import Footer from "../components/layout/Footer.astro";
import SeoHead from "../components/layout/SeoHead.astro";

interface Props { title?: string; description?: string; image?: string; noindex?: boolean; }
const { title, description = "Personalized acupuncture and integrative care in Mesa and Payson, Arizona.", image, noindex = false } = Astro.props;
const [settings, locations] = await Promise.all([getSiteSettings(), getLocations()]);
const pageTitle = title ? `${title} | ${settings.businessName}` : `${settings.businessName} | Acupuncture in Mesa & Payson`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#16302A" />
    <SeoHead title={pageTitle} description={description} image={image} noindex={noindex} />
    <slot name="head" />
  </head>
  <body data-page-section={Astro.url.pathname === "/" ? "home" : Astro.url.pathname.split("/").filter(Boolean)[0] || "home"}>
    <a class="skip-link" href="#main-content">Skip to main content</a>
    <Header settings={settings} currentPath={Astro.url.pathname} />
    <main id="main-content"><slot /></main>
    <Footer settings={settings} locations={locations} />
    <script>
      import { initAnalytics } from "../lib/analytics";
      initAnalytics();
    </script>
  </body>
</html>

---
import SiteLayout from "../layouts/SiteLayout.astro";
import ContactForm from "../components/forms/ContactForm";
import LocationCard from "../components/sections/LocationCard.astro";
import Section from "../components/ui/Section.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import BookingActions from "../components/ui/BookingActions.astro";
import JsonLd from "../components/layout/JsonLd.astro";
import { getLocations,getSiteSettings } from "../lib/wix/data";
import { CONTACT_FORM_ID } from "../lib/wix/config";
import { projectFormFields, type FieldModel } from "../lib/contact-form";
import { forms } from "@wix/forms";
const [settings,locations]=await Promise.all([getSiteSettings(),getLocations()]);
const inquiryNames:Record<string,string>={cupping:"Cupping","facial-acupressure":"Facial Acupressure","foot-reflexology":"Foot Reflexology"};
const inquiry=inquiryNames[Astro.url.searchParams.get("service") ?? ""];
let fields:FieldModel[]=[];
try{
  const form:any=await forms.getForm(CONTACT_FORM_ID);
  fields=projectFormFields(form);
}catch(error){console.error("[wix] getForm(contact) failed",error)}
const mesa=locations.find((location)=>location.slug==="mesa"&&location.status==="open");
const localBusiness=mesa?{"@context":"https://schema.org","@type":"MedicalBusiness",name:settings.businessName,url:Astro.url.origin,telephone:mesa.phone,email:mesa.email,address:{"@type":"PostalAddress",streetAddress:[mesa.addressLine1,mesa.addressLine2].filter(Boolean).join(" "),addressLocality:mesa.city,addressRegion:mesa.state,postalCode:mesa.postalCode,addressCountry:"US"}}:null;
---
<SiteLayout title="Contact & Locations" description="Contact Marin Holy Hill Acupuncture Clinic in Mesa or Payson, get directions, call, book online, or send a general inquiry.">
  {localBusiness && <JsonLd slot="head" data={localBusiness} />}
  <header class="page-hero container"><Eyebrow>Contact</Eyebrow><h1>Two locations. One thoughtful next step.</h1><p class="lede">Choose Zocdoc, book directly with the clinic, or use the form for a general question. Payson is opening soon.</p>{inquiry && <p class="notice">You’re asking about <strong>{inquiry}</strong>. Mention it in your message or when you call so we can help with the right next step.</p>}<BookingActions bookingUrl={settings.bookingUrl} section="contact_hero" class="contact-booking-actions" /></header>
  <Section id="clinic-locations" tone="surface"><h2>Clinic locations</h2>{locations.length?<div class="locations">{locations.map((location)=><LocationCard location={location} />)}</div>:<p class="empty-state">Location information is temporarily unavailable. Please call {settings.phone}.</p>}</Section>
  <Section class="contact-section"><div class="contact-grid"><div><Eyebrow>General inquiry</Eyebrow><h2>Send a message</h2><p class="form-intro">Use this form for scheduling and general questions only.</p>{fields.length?<ContactForm client:load fields={fields} />:<p class="empty-state">Our form is temporarily unavailable. Please call <a href={`tel:${settings.phone.replace(/[^\d+]/g,"")}`}>{settings.phone}</a> or email <a href={`mailto:${settings.email}`}>{settings.email}</a>.</p>}</div><aside><h2>Prefer another route?</h2><p><strong>Book on Zocdoc</strong><br /><a href={settings.bookingUrl} target="_blank" rel="noopener noreferrer" data-analytics-event="booking_click" data-analytics-section="contact_alternate_zocdoc">Open Zocdoc</a> in a new tab.</p><p><strong>Book directly</strong><br /><a href="/book" data-analytics-event="booking_click" data-analytics-section="contact_alternate_direct">Choose a clinic</a>. Mesa is available now; Payson is opening soon.</p><p><strong>Call the clinic</strong><br /><a href={`tel:${settings.phone.replace(/[^\d+]/g,"")}`} data-analytics-event="phone_click" data-analytics-section="contact_alternate_route">{settings.phone}</a><br />We can answer general questions and help with scheduling.</p><p><strong>Email</strong><br /><a href={`mailto:${settings.email}`}>{settings.email}</a></p><p class="notice">Do not send urgent symptoms or sensitive health details by email or this form.</p></aside></div></Section>
</SiteLayout>
<style>
  :global(.contact-booking-actions){margin-top:1.5rem}.locations{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-md)}:global(.contact-section){padding-block:clamp(2.25rem,5vw,4.25rem)}.contact-grid{display:grid;grid-template-columns:minmax(0,1.65fr) minmax(15rem,.75fr);gap:clamp(2rem,6vw,5rem);align-items:start}.form-intro{margin-bottom:.65rem}.contact-grid aside{padding:1.25rem;background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg)}.contact-grid aside h2{font-size:var(--step-2)}.contact-grid aside p{font-size:.9rem;line-height:1.5}.contact-grid aside .notice{padding:.7rem .85rem;font-size:.78rem}
  @media(max-width:760px){.locations,.contact-grid{grid-template-columns:1fr}}
</style>

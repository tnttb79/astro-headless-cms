---
import SiteLayout from "../layouts/SiteLayout.astro";
import Section from "../components/ui/Section.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import { getLocations } from "../lib/wix/data";
import { getDirectBookingOption } from "../lib/booking";

const locations = await getLocations();
---
<SiteLayout title="Book Directly" description="Choose the Mesa or Payson clinic to book directly with Marin Holy Hill Acupuncture Clinic.">
  <header class="page-hero container">
    <Eyebrow>Book directly</Eyebrow>
    <h1>Choose your clinic.</h1>
    <p class="lede">Mesa is available now by phone. Payson direct booking will become available when the new clinic opens.</p>
  </header>
  <Section tone="surface" class="booking-location-section">
    {locations.length ? <div class="booking-grid">
      {locations.map((location) => {
        const option = getDirectBookingOption(location);
        return <article class={`booking-card ${option.available ? "" : "booking-card--unavailable"}`}>
          <p class={`status ${option.available ? "status--available" : "status--unavailable"}`}>{option.available ? "Available now" : "Opening soon"}</p>
          <h2>{location.name}</h2>
          <p class="address">{location.addressLine1}{location.addressLine2 && <><br />{location.addressLine2}</>}<br />{location.city}, {location.state} {location.postalCode}</p>
          {option.available && option.href ? <>
            <p class="booking-note">For now, direct booking is handled by phone.</p>
            <p class="phone"><a href={option.href} data-analytics-event="phone_click" data-analytics-section={`direct_booking_${location.slug}`}>{location.phone}</a></p>
            <Button href={option.href} analyticsEvent="phone_click" analyticsSection={`direct_booking_${location.slug}`}>Book directly</Button>
          </> : <>
            <p class="booking-note">Direct booking will be available when this clinic opens.</p>
            <span class="unavailable-action" aria-disabled="true">Book directly</span>
          </>}
        </article>;
      })}
    </div> : <p class="empty-state">Direct booking options are temporarily unavailable. Please use the Contact page.</p>}
  </Section>
</SiteLayout>
<style>
  :global(.booking-location-section){padding-top:clamp(2.25rem,5vw,4.25rem)}
  .booking-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-md)}
  .booking-card{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(1.5rem,4vw,2.5rem);background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg);box-shadow:var(--shadow)}
  .booking-card--unavailable{background:color-mix(in srgb,var(--paper) 78%,var(--surface));border-style:dashed;box-shadow:none}
  .status{margin:0 0 var(--space-md);padding:.35rem .65rem;border-radius:999px;font:600 var(--step--1)/1.2 var(--font-utility);letter-spacing:.04em;text-transform:uppercase}
  .status--available{background:color-mix(in srgb,var(--pine) 12%,var(--surface));color:var(--pine-deep)}
  .status--unavailable{background:var(--dawn-pale);color:var(--dawn-ink)}
  .booking-card h2{font-size:var(--step-2)}
  .address{color:var(--muted)}
  .booking-note{margin-top:var(--space-lg);color:var(--muted);font-size:var(--step--1)}
  .phone{margin-bottom:var(--space-md);font-size:var(--step-1)}
  .unavailable-action{min-height:44px;display:inline-flex;align-items:center;justify-content:center;padding:.72rem 1.15rem;border:1px solid var(--line);border-radius:999px;background:color-mix(in srgb,var(--line) 58%,var(--surface));color:var(--muted);font:600 var(--step--1)/1 var(--font-body);cursor:not-allowed}
  @media(max-width:700px){.booking-grid{grid-template-columns:1fr}}
</style>

---
import SiteLayout from "../layouts/SiteLayout.astro";
import Section from "../components/ui/Section.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import BookingWizard from "../components/booking/BookingWizard.tsx";
import { getBookableServices, getBookingSettings, getLocations, getSiteSettings } from "../lib/wix/data";

const [settings, services, locations, bookingSettings] = await Promise.all([
  getSiteSettings(),
  getBookableServices(),
  getLocations(),
  getBookingSettings(),
]);

// Props for the wizard island (only non-sensitive display data).
const wizardServices = services.map((s) => ({ key: s.key, label: s.label, allowsFirstTime: s.allowsFirstTime, allowsExisting: s.allowsExisting }));
const wizardLocations = locations.map((l) => ({ slug: l.slug, name: l.name, status: l.status, city: l.city, state: l.state }));
const telHref = `tel:${settings.phone.replace(/[^\d+]/g, "")}`;
---
<SiteLayout title="Book an Appointment" description="Book directly online with Marin Holy Hill Acupuncture Clinic in Mesa, or schedule through Zocdoc.">
  <header class="page-hero container">
    <Eyebrow>Book</Eyebrow>
    <h1>Book your appointment.</h1>
    <p class="lede">Schedule directly online below, or book through Zocdoc — whichever you prefer.</p>
  </header>

  <Section tone="surface" class="booking-direct-section">
    <div class="booking-direct">
      <div class="booking-direct-intro">
        <h2>Book directly online</h2>
        <p>Choose your service, location, and a time that works for you at our Mesa clinic. Payson booking opens when the new clinic does.</p>
      </div>
      <BookingWizard
        client:only="react"
        services={wizardServices}
        locations={wizardLocations}
        cancellationPolicyText={bookingSettings.cancellationPolicyText}
        slotMinutes={bookingSettings.slotMinutes}
        maxAdvanceDays={bookingSettings.maxAdvanceDays}
        clinicPhone={settings.phone}
      />
    </div>
  </Section>

  <Section class="booking-alt-section">
    <div class="booking-alt">
      <div class="booking-alt-card">
        <h2>Prefer Zocdoc?</h2>
        <p>Book through the clinic's Zocdoc profile in a new tab.</p>
        <Button href={settings.bookingUrl} external analyticsEvent="booking_click" analyticsSection="book_page_zocdoc">Book through Zocdoc</Button>
      </div>
      <div class="booking-alt-card">
        <h2>Rather call?</h2>
        <p>Reach the Mesa clinic directly and we'll help you schedule.</p>
        <p class="phone"><a href={telHref} data-analytics-event="phone_click" data-analytics-section="book_page">{settings.phone}</a></p>
      </div>
    </div>
  </Section>
</SiteLayout>
<style>
  :global(.booking-direct-section){padding-top:clamp(2rem,4.5vw,3.75rem)}
  .booking-direct-intro h2{font-size:var(--step-2)}
  .booking-direct-intro p{color:var(--muted);max-width:44rem}
  .booking-direct-intro{margin-bottom:clamp(1.5rem,3vw,2.25rem)}
  .booking-alt{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:var(--space-md)}
  .booking-alt-card{padding:clamp(1.25rem,3vw,1.9rem);background:var(--surface);border:1px solid var(--line);border-radius:var(--radius-lg)}
  .booking-alt-card h2{font-size:var(--step-1)}
  .booking-alt-card p{color:var(--muted)}
  .booking-alt-card .phone{font-size:var(--step-1);margin-top:.4rem}
  .booking-alt-card .phone a{font-weight:600}
  @media(max-width:700px){.booking-alt{grid-template-columns:1fr}}
</style>

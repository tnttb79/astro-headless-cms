---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { getTreatments } from "../../lib/wix/data";

const treatments = await getTreatments();

// Group by category for a simple, scannable listing.
const byCategory = new Map<string, typeof treatments>();
for (const t of treatments) {
  const list = byCategory.get(t.category) ?? [];
  list.push(t);
  byCategory.set(t.category, list);
}
---

<SiteLayout title="Treatments" description="Acupuncture and holistic treatments offered at the clinic.">
  <h1>Treatments</h1>
  <p class="lede">Personalized, whole-person care. Each plan is tailored after a careful assessment.</p>

  {treatments.length === 0 ? (
    <p class="empty">Treatment information is being prepared. Please check back soon.</p>
  ) : (
    [...byCategory.entries()].map(([category, list]) => (
      <section>
        <h2>{category}</h2>
        <div class="grid">
          {list.map((t) => (
            <article class="card">
              <h3><a href={`/treatments/${t.slug}`}>{t.title}</a></h3>
              <p>{t.shortDescription}</p>
              <p class="meta">{[t.duration, t.price].filter(Boolean).join(" · ")}</p>
            </article>
          ))}
        </div>
      </section>
    ))
  )}
</SiteLayout>

<style>
  h1 { color: var(--brand-dark); }
  .lede { color: var(--muted); font-size: 1.1rem; max-width: 60ch; }
  h2 { color: var(--brand-dark); margin-top: 2rem; }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; }
  .card h3 { margin: 0 0 0.4rem; }
  .card h3 a { text-decoration: none; }
  .meta { color: var(--muted); font-size: 0.9rem; }
  .empty { color: var(--muted); font-style: italic; }
</style>

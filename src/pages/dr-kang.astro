---
import SiteLayout from "../layouts/SiteLayout.astro";
import Section from "../components/ui/Section.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import JsonLd from "../components/layout/JsonLd.astro";
import { DR_KANG_CONTENT } from "../content/dr-kang";
import { SITE_IMAGES } from "../lib/images";
import { getSiteSettings } from "../lib/wix/data";
const settings=await getSiteSettings();
const person={"@context":"https://schema.org","@type":"Person",name:settings.doctorName,jobTitle:"Acupuncturist",worksFor:{"@type":"MedicalBusiness",name:settings.businessName},url:new URL("/dr-kang",Astro.url.origin).toString()};
const sections=[{id:"meet",...DR_KANG_CONTENT.meet,image:SITE_IMAGES.doctorMeet},{id:"why",...DR_KANG_CONTENT.why,image:SITE_IMAGES.whyChoose},{id:"complex",...DR_KANG_CONTENT.complex,image:SITE_IMAGES.doctorComplex}];
---
<SiteLayout title="Meet Dr. Hyo-won Kang" description="Learn about Dr. Kang’s third-generation tradition, education, faith, 28 years of experience, and individualized approach to acupuncture.">
  <JsonLd slot="head" data={person} />
  <header class="page-hero container"><Eyebrow>Dr. Hyo-won Kang</Eyebrow><h1>Tradition, clinical experience, and sincere care.</h1><p class="lede">A third-generation practitioner brings a family tradition of medicine into a modern, whole-person practice.</p><nav class="anchor-nav" aria-label="On this page"><a href="#meet">Meet Dr. Kang</a><a href="#why">Why choose Dr. Kang?</a><a href="#complex">Chronic & complex</a></nav></header>
  {sections.map((section,index)=><Section id={section.id} tone={index%2===0?"surface":"paper"}><div class={`story ${index%2 ? "story--reverse" : ""}`}><div class="image-frame"><img src={section.image.src} srcset={section.image.srcSet} sizes="(max-width:800px) 100vw, 48vw" width={section.image.width} height={section.image.height} alt={section.image.alt} loading={index===0?"eager":"lazy"} decoding="async" /></div><div><Eyebrow>{String(index+1).padStart(2,"0")}</Eyebrow><h2>{section.title}</h2>{section.paragraphs.map((paragraph)=><p>{paragraph}</p>)}</div></div></Section>)}
  <CtaBand bookingUrl={settings.bookingUrl} phone={settings.phone} heading="Begin with a thoughtful conversation." section="dr_kang_footer" />
</SiteLayout>
<style>
  .story{display:grid;grid-template-columns:1fr 1fr;gap:clamp(2rem,7vw,6rem);align-items:center}.story--reverse .image-frame{order:2}.image-frame{aspect-ratio:4/3}.image-frame img{width:100%;height:100%;object-fit:cover}.story p{max-width:64ch;color:var(--muted)}
  @media(max-width:780px){.story{grid-template-columns:1fr}.story--reverse .image-frame{order:0}}
</style>

---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getTreatments, getConditions, getSiteSettings } from "../lib/wix/data";

const [settings, treatments, conditions] = await Promise.all([
  getSiteSettings(),
  getTreatments(),
  getConditions(),
]);

const featuredTreatments = treatments.filter((t) => t.featured).slice(0, 3);
const shownTreatments = featuredTreatments.length ? featuredTreatments : treatments.slice(0, 3);
---

<SiteLayout
  title="Root-cause, whole-person acupuncture care"
  description="Marin Holy Hill Acupuncture Clinic — third-generation, faith-based, whole-person care in Mesa, AZ."
>
  <section class="hero">
    <h1>Don't just treat the pain. Master your health.</h1>
    <p class="lede">
      {settings.businessName} offers root-cause, whole-person acupuncture care with
      {settings.doctorName}. Every visit begins with careful listening and a personalized plan.
    </p>
    <a class="btn" href={settings.bookingUrl}>Request an appointment</a>
  </section>

  <section>
    <h2>Featured treatments</h2>
    {shownTreatments.length === 0 ? (
      <p class="empty">Treatment information is being prepared. Please check back soon.</p>
    ) : (
      <div class="grid">
        {shownTreatments.map((t) => (
          <article class="card">
            <span class="tag">{t.category}</span>
            <h3><a href={`/treatments/${t.slug}`}>{t.title}</a></h3>
            <p>{t.shortDescription}</p>
            {t.price && <p class="meta">{t.price}</p>}
          </article>
        ))}
      </div>
    )}
    <p><a href="/treatments">View all treatments →</a></p>
  </section>

  <section>
    <h2>Conditions we help with</h2>
    {conditions.length === 0 ? (
      <p class="empty">Condition information is being prepared. Please check back soon.</p>
    ) : (
      <ul class="conditions">
        {conditions.map((c) => (
          <li>
            <strong>{c.title}</strong>
            <span class="tag">{c.category}</span>
            <p>{c.summary}</p>
          </li>
        ))}
      </ul>
    )}
  </section>

  <section class="cta">
    <h2>Ready to start?</h2>
    <p>Have a question or want to book a first visit? We're happy to help.</p>
    <a class="btn" href="/contact">Contact the clinic</a>
  </section>
</SiteLayout>

<style>
  .hero { padding: 1rem 0 2rem; border-bottom: 1px solid var(--line); margin-bottom: 2rem; }
  .hero h1 { font-size: clamp(1.8rem, 4vw, 2.8rem); line-height: 1.15; color: var(--brand-dark); margin: 0 0 0.75rem; }
  .lede { font-size: 1.15rem; color: var(--muted); max-width: 60ch; }
  section { margin-bottom: 2.5rem; }
  h2 { color: var(--brand-dark); }
  .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .card { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.25rem; }
  .card h3 { margin: 0.4rem 0; }
  .card h3 a { text-decoration: none; }
  .tag { display: inline-block; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.04em; color: var(--brand); background: #eaf1ee; padding: 0.15rem 0.5rem; border-radius: 999px; }
  .meta { color: var(--muted); font-size: 0.9rem; }
  .conditions { list-style: none; padding: 0; display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); }
  .conditions li { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1rem 1.25rem; }
  .conditions p { margin: 0.4rem 0 0; color: var(--muted); font-size: 0.95rem; }
  .empty { color: var(--muted); font-style: italic; }
  .cta { background: var(--card); border: 1px solid var(--line); border-radius: var(--radius); padding: 1.5rem; text-align: center; }
</style>

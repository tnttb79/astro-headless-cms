---
import SiteLayout from "../layouts/SiteLayout.astro";
import Hero from "../components/sections/Hero.astro";
import TrustStrip from "../components/sections/TrustStrip.astro";
import ServiceGrid from "../components/sections/ServiceGrid.astro";
import ConditionCategoryGrid from "../components/sections/ConditionCategoryGrid.astro";
import ProcessSteps from "../components/sections/ProcessSteps.astro";
import TestimonialRow from "../components/sections/TestimonialRow.astro";
import LocationCard from "../components/sections/LocationCard.astro";
import CtaBand from "../components/sections/CtaBand.astro";
import Section from "../components/ui/Section.astro";
import Eyebrow from "../components/ui/Eyebrow.astro";
import Button from "../components/ui/Button.astro";
import RidgelineDivider from "../components/ui/RidgelineDivider.astro";
import JsonLd from "../components/layout/JsonLd.astro";
import { CONDITION_CATEGORIES } from "../content/condition-categories";
import { FIRST_VISIT_STEPS } from "../content/new-patient";
import { HOME_CONTENT } from "../content/home";
import { SITE_IMAGES } from "../lib/images";
import { getConditions,getLocations,getSiteSettings,getTestimonials,getTreatments } from "../lib/wix/data";
const [settings,services,conditions,locations,testimonials]=await Promise.all([getSiteSettings(),getTreatments(),getConditions(),getLocations(),getTestimonials()]);
const featured=services.filter((service)=>service.featured).slice(0,3);
const mesa=locations.find((location)=>location.slug==="mesa"&&location.status==="open");
const structuredData=[{"@context":"https://schema.org","@type":"Person",name:settings.doctorName,jobTitle:"Acupuncturist",url:new URL("/dr-kang",Astro.url.origin).toString()},...(mesa?[{"@context":"https://schema.org","@type":"MedicalBusiness",name:settings.businessName,url:Astro.url.origin,telephone:mesa.phone,address:{"@type":"PostalAddress",streetAddress:[mesa.addressLine1,mesa.addressLine2].filter(Boolean).join(" "),addressLocality:mesa.city,addressRegion:mesa.state,postalCode:mesa.postalCode,addressCountry:"US"}}]:[])];
---
<SiteLayout description="Personalized, third-generation acupuncture and integrative care from Dr. Hyo-won Kang in Mesa and Payson, Arizona.">
  <JsonLd slot="head" data={structuredData} />
  <Hero bookingUrl={settings.bookingUrl} />
  <TrustStrip />
  <Section><div class="split"><div class="portrait image-frame"><img src={SITE_IMAGES.homeDoctor.src} srcset={SITE_IMAGES.homeDoctor.srcSet} sizes="(max-width:800px) 17rem, 17rem" width={SITE_IMAGES.homeDoctor.width} height={SITE_IMAGES.homeDoctor.height} alt={SITE_IMAGES.homeDoctor.alt} loading="lazy" decoding="async" style={`object-position:${SITE_IMAGES.homeDoctor.position}`} /></div><div><Eyebrow>Meet Dr. Kang</Eyebrow><h2>Care shaped by lineage and listening.</h2><p class="lede">{HOME_CONTENT.doctor}</p><Button href="/dr-kang" variant="secondary" analyticsEvent="cta_click" analyticsSection="home_doctor">Meet Dr. Kang</Button></div></div></Section>
  <Section tone="dawn"><div class="insurance-preview"><div><Eyebrow>Veterans, insurance &amp; fees</Eyebrow><h2>A clear path before care begins.</h2><p>Veterans with an approved VA community-care authorization can contact the clinic to coordinate scheduling. Insurance benefits vary by plan; self-pay fees are listed for planning and should be confirmed when scheduling.</p></div><Button href="/va-insurance#va-care" variant="secondary" analyticsEvent="cta_click" analyticsSection="home_insurance">VA steps, insurance &amp; pricing</Button></div></Section>
  <RidgelineDivider />
  <Section tone="surface" class="featured-services"><Eyebrow>What we offer</Eyebrow><h2>Featured services</h2><p class="lede">A focused selection from our live services. Each plan is personalized after an assessment.</p><ServiceGrid services={featured.length?featured:services.slice(0,3)} compact /><div class="section-action"><Button href="/services" variant="ghost" analyticsEvent="cta_click" analyticsSection="home_services">View all services</Button></div></Section>
  <Section><Eyebrow>What brings you in?</Eyebrow><h2>Explore by concern</h2><ConditionCategoryGrid categories={CONDITION_CATEGORIES} conditions={conditions} /></Section>
  <Section tone="pine"><div class="split"><div><Eyebrow>Why Holy Hill</Eyebrow><h2>Personalized care, without promises.</h2><p class="lede">{HOME_CONTENT.why}</p><ul class="checks"><li>Third-generation traditional medicine heritage</li><li>28 years of clinical experience</li><li>Pulse diagnosis, palpation, and detailed history</li><li>Faith expressed with humility and welcome</li></ul></div><div class="image-frame wide"><img src={SITE_IMAGES.whyChoose.src} srcset={SITE_IMAGES.whyChoose.srcSet} sizes="(max-width:800px) calc(100vw - 2rem), 45vw" width={SITE_IMAGES.whyChoose.width} height={SITE_IMAGES.whyChoose.height} alt={SITE_IMAGES.whyChoose.alt} loading="lazy" decoding="async" style={`object-position:${SITE_IMAGES.whyChoose.position}`} /></div></div></Section>
  {testimonials.length > 0 && <Section tone="surface"><Eyebrow>Patient voices</Eyebrow><h2>Already shared by our patients</h2><TestimonialRow testimonials={testimonials} /><p class="testimonial-note">Testimonials describe individual experiences and do not promise similar results.</p></Section>}
  <Section><div class="process-head"><div><Eyebrow>New patients</Eyebrow><h2>A clear first visit.</h2><p class="lede">{HOME_CONTENT.process}</p></div><Button href="/new-patient" variant="ghost" analyticsEvent="cta_click" analyticsSection="home_process">Read the full guide</Button></div><ProcessSteps steps={FIRST_VISIT_STEPS.slice(0,3)} /></Section>
  <Section tone="surface"><Eyebrow>Find us</Eyebrow><h2>Mesa and Payson</h2>{locations.length?<div class="locations">{locations.map((location)=><LocationCard location={location} />)}</div>:<p class="empty-state">Location details are temporarily unavailable. Please call {settings.phone}.</p>}</Section>
  <CtaBand bookingUrl={settings.bookingUrl} heading="Begin with care that listens." section="home_footer" />
</SiteLayout>
<style>
  .split{display:grid;grid-template-columns:.85fr 1.15fr;gap:clamp(2rem,7vw,6rem);align-items:center}.portrait{width:17rem;max-width:100%;aspect-ratio:5/6;justify-self:center}.portrait img,.wide img{width:100%;height:100%;object-fit:cover}.wide{aspect-ratio:4/3}.section-action{margin-top:var(--space-lg)}:global(.featured-services){padding-block:clamp(2rem,4vh,3rem)}:global(.featured-services) .section-action{margin-top:var(--space-md)}.checks{display:grid;gap:.65rem;padding:0;list-style:none}.checks li::before{content:"—";margin-right:.6rem;color:var(--dawn)}.testimonial-note{margin-top:1rem;color:var(--muted);font-size:var(--step--1)}.process-head,.insurance-preview{display:flex;align-items:end;justify-content:space-between;gap:var(--space-lg);margin-bottom:var(--space-lg)}.locations{display:grid;grid-template-columns:repeat(2,1fr);gap:var(--space-md)}
  .insurance-preview :global(.button){flex:0 0 auto;min-width:17rem;padding-inline:1.5rem;white-space:nowrap}
  @media(max-width:800px){.split,.locations{grid-template-columns:1fr}.process-head,.insurance-preview{display:block}.process-head :global(.button),.insurance-preview :global(.button){margin-top:1rem}}
  @media(max-width:360px){.insurance-preview :global(.button){width:100%;min-width:0;white-space:normal}}
</style>

---
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import RidgelineDivider from "../ui/RidgelineDivider.astro";
import { SITE_IMAGES } from "../../lib/images";
interface Props { bookingUrl: string; }
const { bookingUrl } = Astro.props;
const hero = SITE_IMAGES.homeHero;
---
<section class="hero">
  <div class="hero__media"><img src={hero.src} srcset={hero.srcSet} sizes="(max-width:760px) 100vw, min(58vw, 975px)" width={hero.width} height={hero.height} alt={hero.alt} loading="eager" decoding="async" fetchpriority="high" /><div class="shade"></div></div>
  <div class="container hero__content">
    <Eyebrow>Third-generation care · Mesa & Payson</Eyebrow>
    <h1>Experienced care. Sincere attention.</h1>
    <p>Personalized acupuncture and integrative support from Dr. Hyo-won Kang, shaped by a third-generation tradition and 28 years of clinical experience.</p>
    <div class="actions">
      <Button href={bookingUrl} external analyticsEvent="booking_click" analyticsSection="home_hero">Book an appointment</Button>
      <Button href="/contact" variant="ghost" analyticsEvent="cta_click" analyticsSection="home_hero">Contact Mesa &amp; Payson</Button>
    </div>
  </div>
</section>
<RidgelineDivider variant="hero" />
<style>
  .hero { --eyebrow-color: var(--dawn); position: relative; min-height: clamp(36rem, 68vh, 44rem); display: grid; align-items: center; overflow: hidden; background: var(--pine-deep); }
  .hero__media { position: absolute; right: 0; top: 50%; width: min(58vw, 60.94rem); aspect-ratio: 975/549; transform: translateY(-50%); overflow: hidden; }
  .hero__media img, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero__media img { object-fit: cover; object-position: center 42%; animation: reveal-image 1.1s ease-out both; }
  .shade { background: linear-gradient(90deg, var(--pine-deep) 0%, rgb(22 48 42 / .72) 22%, transparent 70%), linear-gradient(0deg, rgb(16 31 27 / .35), transparent 48%); }
  .hero__content { position: relative; z-index: 1; padding-block: clamp(5rem, 10vw, 7rem); color: white; animation: reveal-copy .75s .18s ease-out both; }
  h1 { max-width: 13ch; color: white; }
  p { max-width: 47ch; font-size: var(--step-1); }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.6rem; }
  .hero :global(.button--ghost) { color: white; }
  @keyframes reveal-image { from { opacity: .6; transform: scale(1.035); } to { opacity: 1; transform: scale(1); } }
  @keyframes reveal-copy { from { opacity: 0; transform: translateY(1rem); } to { opacity: 1; transform: none; } }
  @media (max-width: 760px) { .hero { min-height: 44rem; align-items: end; } .hero__media { top: 0; width: 100%; transform: none; } .shade { background: linear-gradient(0deg,var(--pine-deep) 0%,transparent 68%); } .hero__content { padding-block: 18rem 3.5rem; } }
  @media (max-width: 560px) { .actions :global(.button) { width: 100%; } }
</style>

---
import Button from "../ui/Button.astro";
import Eyebrow from "../ui/Eyebrow.astro";
import RidgelineDivider from "../ui/RidgelineDivider.astro";
import { SITE_IMAGES } from "../../lib/images";
interface Props { bookingUrl: string; phone: string; }
const { bookingUrl, phone } = Astro.props;
const hero = SITE_IMAGES.homeHero;
---
<section class="hero">
  <img src={hero.src} srcset={hero.srcSet} sizes="100vw" width={hero.width} height={hero.height} alt={hero.alt} loading="eager" decoding="async" fetchpriority="high" />
  <div class="shade"></div>
  <div class="container hero__content">
    <Eyebrow>Third-generation care · Mesa & Payson</Eyebrow>
    <h1>Traditional care for the whole person.</h1>
    <p>Personalized acupuncture and integrative support from Dr. Hyo-won Kang, grounded in 28 years of clinical experience.</p>
    <div class="actions">
      <Button href={bookingUrl} external analyticsEvent="booking_click" analyticsSection="home_hero">Book an appointment</Button>
      <Button href={`tel:${phone.replace(/[^\d+]/g, "")}`} variant="ghost" analyticsEvent="phone_click" analyticsSection="home_hero">Call {phone}</Button>
    </div>
  </div>
</section>
<RidgelineDivider variant="hero" />
<style>
  .hero { --eyebrow-color: var(--dawn); position: relative; min-height: clamp(34rem, 74vh, 47rem); display: grid; align-items: end; overflow: hidden; background: var(--pine-deep); }
  .hero > img, .shade { position: absolute; inset: 0; width: 100%; height: 100%; }
  .hero > img { object-fit: cover; object-position: center 42%; animation: reveal-image 1.1s ease-out both; }
  .shade { background: linear-gradient(90deg, rgb(16 31 27 / .88) 0%, rgb(16 31 27 / .58) 52%, rgb(16 31 27 / .18) 100%), linear-gradient(0deg, rgb(16 31 27 / .72), transparent 55%); }
  .hero__content { position: relative; z-index: 1; padding-block: clamp(5rem, 13vw, 9rem) 3.2rem; color: white; animation: reveal-copy .75s .18s ease-out both; }
  h1 { max-width: 13ch; color: white; }
  p { max-width: 47ch; font-size: var(--step-1); }
  .actions { display: flex; flex-wrap: wrap; gap: .75rem; margin-top: 1.6rem; }
  .hero :global(.button--ghost) { color: white; }
  @keyframes reveal-image { from { opacity: .6; transform: scale(1.035); } to { opacity: 1; transform: scale(1); } }
  @keyframes reveal-copy { from { opacity: 0; transform: translateY(1rem); } to { opacity: 1; transform: none; } }
  @media (max-width: 560px) { .actions :global(.button) { width: 100%; } }
</style>

---
interface Step { title: string; text: string; }
interface Props { steps: Step[]; }
const { steps } = Astro.props;
---
<ol class="steps">{steps.map((step,index) => <li><span>{String(index+1).padStart(2,"0")}</span><div><h3>{step.title}</h3><p>{step.text}</p></div></li>)}</ol>
<style>
  .steps { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(2,1fr); gap: 0 var(--space-lg); counter-reset: none; }
  li { display: grid; grid-template-columns: 3.2rem 1fr; gap: 1rem; padding: 1.4rem 0; border-top: 1px solid var(--line); }
  li > span { color: var(--dawn-ink); font: 500 var(--step-1)/1 var(--font-utility); }
  h3 { font-size: var(--step-1); }
  p { margin: 0; color: var(--muted); }
  @media (max-width: 700px) { .steps { grid-template-columns: 1fr; } }
</style>

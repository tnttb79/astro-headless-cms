---
const items = [
  ["Third-generation tradition", "A family lineage of care"],
  ["28 years of experience", "Clinical perspective over time"],
  ["One-to-one care plans", "Personalized to the individual"],
  ["Mesa and Payson", "Two Arizona clinic locations"],
];
---
<section class="trust" aria-label="Clinic highlights"><div class="container"><ul>{items.map(([heading,detail]) => <li><strong>{heading}</strong><span>{detail}</span></li>)}</ul></div></section>
<style>
  .trust { padding: .5rem 0 2.5rem; }
  ul { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(4,1fr); border-block: 1px solid var(--line); }
  li { display: flex; flex-direction: column; justify-content: center; gap: .3rem; min-height: 5.8rem; padding: 1rem 1.15rem; border-right: 1px solid var(--line); }
  li:last-child { border-right: 0; }
  strong { color: var(--pine-deep); font: 600 var(--step--1)/1.35 var(--font-body); }
  span { color: var(--pine-deep); font-size: var(--step--1); }
  @media (max-width: 700px) { ul { grid-template-columns: repeat(2,1fr); } li:nth-child(2) { border-right: 0; } li:nth-child(-n+2) { border-bottom: 1px solid var(--line); } }
</style>

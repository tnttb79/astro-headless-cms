---
import type { Treatment } from "../../types/content";
import Card from "../ui/Card.astro";
import Badge from "../ui/Badge.astro";
import { getServiceImage } from "../../lib/images";
interface Props { services: Treatment[]; showImages?: boolean; compact?: boolean; }
const { services, showImages = true, compact = false } = Astro.props;
const gridClass = compact ? "service-grid service-grid--compact" : "service-grid";
---
{services.length ? <div class={gridClass}>
  {services.map((service) => {
    const img = getServiceImage(service.slug, service.imagePath);
    return <Card class="service-card">
      {showImages && <a class="service-image" href={`/services/${service.slug}`} tabindex="-1"><img src={img.src} srcset={img.srcSet || undefined} sizes="(max-width: 620px) calc(100vw - 2rem), (max-width: 900px) 50vw, 33vw" width={img.width} height={img.height} alt={img.alt} loading="lazy" decoding="async" style={`object-position:${img.position}`} /></a>}
      <div class="service-copy">
        <Badge>{service.serviceGroup === "specialized" ? "Specialized care" : "Service"}</Badge>
        <h3><a href={`/services/${service.slug}`}>{service.title}</a></h3>
        <p>{service.shortDescription}</p>
        <a class="learn" href={`/services/${service.slug}`}>Explore this service <span aria-hidden="true">→</span></a>
      </div>
    </Card>;
  })}
</div> : <p class="empty-state">Service information is temporarily unavailable. Please call the clinic for help.</p>}
<style>
  .service-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: var(--space-md); }
  :global(.service-card) { padding: 0; overflow: hidden; }
  .service-image { display: block; aspect-ratio: 4/3; overflow: hidden; background: var(--dawn-pale); }
  .service-image img { width: 100%; height: 100%; object-fit: cover; transition: transform .3s ease; }
  .service-image:hover img { transform: scale(1.025); }
  .service-copy { padding: 1.35rem; }
  .service-grid--compact .service-image { aspect-ratio: 16/9; }
  .service-grid--compact .service-copy { padding: 1rem 1.2rem 1.2rem; }
  .service-grid--compact h3 { font-size: clamp(1.4rem,1.2rem + .55vw,1.8rem); }
  .service-grid--compact p { font-size: var(--step-0); line-height: 1.5; }
  h3 { margin-top: .75rem; }
  h3 a { color: inherit; text-decoration: none; }
  p { color: var(--muted); }
  .learn { font-weight: 600; text-decoration: none; }
  @media (max-width: 900px) { .service-grid { grid-template-columns: repeat(2,minmax(0,1fr)); } }
  @media (max-width: 620px) { .service-grid { grid-template-columns: 1fr; } }
</style>

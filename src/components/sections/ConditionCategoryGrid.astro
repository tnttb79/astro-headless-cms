---
import Card from "../ui/Card.astro";
import type { ConditionCategory } from "../../content/condition-categories";
import type { Condition } from "../../types/content";
interface Props { categories: ConditionCategory[]; conditions: Condition[]; }
const { categories, conditions } = Astro.props;
---
<div class="category-grid">
  {categories.map((category) => {
    const count = conditions.filter((condition) => condition.category === category.slug).length;
    return <Card><h3><a href={`/conditions/${category.slug}`}>{category.title}</a></h3><p>{category.intro}</p><a class="view" href={`/conditions/${category.slug}`}>View {count || "the"} conditions <span aria-hidden="true">→</span></a></Card>;
  })}
</div>
<style>
  .category-grid { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); gap: var(--space-md); }
  h3 a { text-decoration: none; color: inherit; }
  p { color: var(--muted); }
  .view { font-weight: 600; text-decoration: none; }
  @media (max-width: 850px) { .category-grid { grid-template-columns: repeat(2,1fr); } }
  @media (max-width: 560px) { .category-grid { grid-template-columns: 1fr; } }
</style>

---
interface Props { as?: "p" | "span"; }
const { as: Tag = "p" } = Astro.props;
---
<Tag class="eyebrow"><slot /></Tag>
<style>
  .eyebrow { margin: 0 0 .7rem; color: var(--eyebrow-color, var(--dawn-ink)); font: 500 var(--step--1)/1.3 var(--font-utility); letter-spacing: .08em; text-transform: uppercase; }
</style>

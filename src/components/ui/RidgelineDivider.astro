---
interface Props { variant?: "hero" | "subtle"; }
const { variant = "subtle" } = Astro.props;
---
<div class={`ridge ridge--${variant}`} aria-hidden="true">
  <svg viewBox="0 0 1440 210" preserveAspectRatio="none">
    <path class="back" d="M0 154L130 115l120 18 145-68 145 51 130-89 162 107 122-72 160 61 122-39 224 54v62H0z" />
    <path class="front" d="M0 177l185-57 133 54 194-91 152 88 194-69 158 75 196-68 228 63v38H0z" />
  </svg>
</div>
<style>
  .ridge { width: 100%; line-height: 0; overflow: hidden; }
  svg { width: 100%; height: 100%; }
  .ridge--hero { height: clamp(7rem, 18vw, 14rem); background: linear-gradient(180deg, var(--dawn-pale), var(--paper)); }
  .ridge--hero .back { fill: color-mix(in srgb, var(--ridge) 72%, var(--paper)); opacity: .52; }
  .ridge--hero .front { fill: var(--pine); }
  .ridge--subtle { height: 3.25rem; background: var(--paper); }
  .ridge--subtle .back { fill: var(--line); }
  .ridge--subtle .front { fill: var(--surface); }
</style>

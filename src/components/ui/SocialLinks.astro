---
import type { SiteSettings } from "../../types/content";
interface Props {
  settings: SiteSettings;
  section?: string;
  class?: string;
  variant?: "neutral" | "brand";
}
const { settings, section = "footer", class: className, variant = "neutral" } = Astro.props;
const instagramGradientId = `instagram-gradient-${section.replace(/[^a-z0-9_-]/gi, "-")}`;
// Solid Instagram badge (filled rounded-square with lens ring + dot knocked out via evenodd)
const instagramBoldPath = "M8 1.75h8a6.25 6.25 0 0 1 6.25 6.25v8a6.25 6.25 0 0 1-6.25 6.25H8A6.25 6.25 0 0 1 1.75 16V8A6.25 6.25 0 0 1 8 1.75ZM12 6.75a5.25 5.25 0 1 0 0 10.5 5.25 5.25 0 0 0 0-10.5ZM12 8.65a3.35 3.35 0 1 1 0 6.7 3.35 3.35 0 0 1 0-6.7ZM17.6 5.05a1.35 1.35 0 1 0 0 2.7 1.35 1.35 0 0 0 0-2.7Z";
const links = [
  { name: "Instagram", slug: "instagram", href: settings.instagramUrl, path: "M12 2.16c3.2 0 3.58.01 4.85.07 1.17.05 1.8.25 2.23.41.56.22.96.48 1.38.9.42.42.68.82.9 1.38.16.42.36 1.06.41 2.23.06 1.27.07 1.65.07 4.85s-.01 3.58-.07 4.85c-.05 1.17-.25 1.8-.41 2.23-.22.56-.48.96-.9 1.38-.42.42-.82.68-1.38.9-.42.16-1.06.36-2.23.41-1.27.06-1.65.07-4.85.07s-3.58-.01-4.85-.07c-1.17-.05-1.8-.25-2.23-.41a3.7 3.7 0 0 1-1.38-.9 3.7 3.7 0 0 1-.9-1.38c-.16-.42-.36-1.06-.41-2.23-.06-1.27-.07-1.65-.07-4.85s.01-3.58.07-4.85c.05-1.17.25-1.8.41-2.23.22-.56.48-.96.9-1.38.42-.42.82-.68 1.38-.9.42-.16 1.06-.36 2.23-.41C8.42 2.17 8.8 2.16 12 2.16Zm0 1.44c-3.15 0-3.52.01-4.76.07-1.15.05-1.77.24-2.19.4-.55.22-.94.47-1.35.88-.41.41-.66.8-.88 1.35-.16.42-.35 1.04-.4 2.19-.06 1.24-.07 1.61-.07 4.76s.01 3.52.07 4.76c.05 1.15.24 1.77.4 2.19.22.55.47.94.88 1.35.41.41.8.66 1.35.88.42.16 1.04.35 2.19.4 1.24.06 1.61.07 4.76.07s3.52-.01 4.76-.07c1.15-.05 1.77-.24 2.19-.4.55-.22.94-.47 1.35-.88.41-.41.66-.8.88-1.35.16-.42.35-1.04.4-2.19.06-1.24.07-1.61.07-4.76s-.01-3.52-.07-4.76c-.05-1.15-.24-1.77-.4-2.19a3.6 3.6 0 0 0-.88-1.35 3.6 3.6 0 0 0-1.35-.88c-.42-.16-1.04-.35-2.19-.4-1.24-.06-1.61-.07-4.76-.07Zm0 3.9a4.5 4.5 0 1 1 0 9 4.5 4.5 0 0 1 0-9Zm0 1.44a3.06 3.06 0 1 0 0 6.12 3.06 3.06 0 0 0 0-6.12Zm4.66-2.6a1.05 1.05 0 1 1 0 2.1 1.05 1.05 0 0 1 0-2.1Z" },
  { name: "Facebook", slug: "facebook", href: settings.facebookUrl, path: "M22 12.06C22 6.5 17.52 2 12 2S2 6.5 2 12.06c0 5.02 3.66 9.18 8.44 9.94v-7.03H7.9v-2.91h2.54V9.85c0-2.52 1.49-3.91 3.78-3.91 1.1 0 2.24.2 2.24.2v2.47h-1.26c-1.24 0-1.63.78-1.63 1.57v1.88h2.78l-.44 2.91h-2.34V22c4.78-.76 8.44-4.92 8.44-9.94Z" },
  { name: "YouTube", slug: "youtube", href: settings.youtubeUrl, path: "M23.5 6.5a3 3 0 0 0-2.11-2.13C19.5 3.86 12 3.86 12 3.86s-7.5 0-9.39.51A3 3 0 0 0 .5 6.5C0 8.4 0 12 0 12s0 3.6.5 5.5a3 3 0 0 0 2.11 2.13c1.89.51 9.39.51 9.39.51s7.5 0 9.39-.51A3 3 0 0 0 23.5 17.5c.5-1.9.5-5.5.5-5.5s0-3.6-.5-5.5ZM9.6 15.57V8.43L15.82 12 9.6 15.57Z" },
].filter((link) => link.href);
const iconSize = variant === "brand" ? 18 : 20;
---
{links.length > 0 && <ul class:list={["social-links", `social-links--${variant}`, className]} aria-label="Social media">
  {links.map((link) => (
    <li>
      <a class={`social-links__${link.slug}`} href={link.href} target="_blank" rel="noopener noreferrer" aria-label={link.name}
        data-analytics-event="social_click" data-analytics-section={`${section}_${link.name.toLowerCase()}`}>
        <svg viewBox="0 0 24 24" width={iconSize} height={iconSize} fill="currentColor" aria-hidden="true" focusable="false">
          {variant === "brand" && link.slug === "instagram" && <defs>
            <linearGradient id={instagramGradientId} x1="0" y1="1" x2="1" y2="0">
              <stop offset="0" stop-color="#feda75" />
              <stop offset=".35" stop-color="#fa7e1e" />
              <stop offset=".65" stop-color="#d62976" />
              <stop offset="1" stop-color="#4f5bd5" />
            </linearGradient>
          </defs>}
          <path d={variant === "brand" && link.slug === "instagram" ? instagramBoldPath : link.path} fill-rule={variant === "brand" && link.slug === "instagram" ? "evenodd" : undefined} fill={variant === "brand" && link.slug === "instagram" ? `url(#${instagramGradientId})` : undefined} />
        </svg>
      </a>
    </li>
  ))}
</ul>}
<style>
  .social-links { display: flex; gap: .65rem; align-items: center; list-style: none; margin: .35rem 0 0; padding: 0; }
  .social-links a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 2.25rem; height: 2.25rem; border-radius: 50%;
    color: white; border: 1px solid color-mix(in srgb, var(--surface) 26%, transparent);
    transition: background-color .18s ease, border-color .18s ease, color .18s ease, box-shadow .18s ease, transform .18s ease;
  }
  .social-links a:hover, .social-links a:focus-visible { background: var(--dawn); border-color: var(--dawn); color: var(--pine-deep); }
  .social-links svg { display: block; }

  /* Brand colors on white chips so they pop against the dark utility bar */
  .social-links--brand { gap: .5rem; margin: 0; }
  .social-links--brand a {
    width: 2rem; height: 2rem; border-radius: 50%; border: 0;
    background: #fff;
    box-shadow: 0 1px 3px rgb(0 0 0 / .25);
  }
  .social-links--brand .social-links__facebook { color: #1877f2; }
  .social-links--brand .social-links__youtube { color: #ff0000; }
  .social-links--brand a:hover, .social-links--brand a:focus-visible {
    background: #fff; transform: translateY(-1px);
    box-shadow: 0 3px 8px rgb(0 0 0 / .3);
  }
</style>

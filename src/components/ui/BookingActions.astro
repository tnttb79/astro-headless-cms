---
import Button from "./Button.astro";
import { DIRECT_BOOKING_PATH } from "../../lib/booking";

type ButtonVariant = "primary" | "secondary" | "ghost";
interface Props {
  // Accepted for backwards compatibility with callers; Zocdoc now lives only on /book.
  bookingUrl?: string;
  section: string;
  directVariant?: ButtonVariant;
  class?: string;
}
const {
  section,
  directVariant = "primary",
  class: className = "",
} = Astro.props;
---
<div class={`booking-actions ${className}`}>
  <Button href={DIRECT_BOOKING_PATH} variant={directVariant} analyticsEvent="booking_click" analyticsSection={`${section}_direct`}>Book online</Button>
</div>
<style>
  .booking-actions { display: flex; flex-wrap: wrap; align-items: center; gap: .7rem; }
</style>

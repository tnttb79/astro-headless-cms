---
interface Props { as?: "article" | "div" | "li"; class?: string; }
const { as: Tag = "article", class: className = "" } = Astro.props;
---
<Tag class={`card ${className}`}><slot /></Tag>
<style>
  .card { height: 100%; padding: clamp(1.25rem, 3vw, 2rem); background: var(--surface); border: 1px solid var(--line); border-radius: var(--radius-lg); box-shadow: 0 1px 0 rgb(27 33 31 / .03); }
</style>
